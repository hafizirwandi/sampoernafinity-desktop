{
  "name": "sampoernafinity-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Sampoernafinity desktop app (Electron)",
  "main": "electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5183 && cross-env VITE_DEV_SERVER_URL=http://localhost:5183 electron .",
    "dev": "concurrently -k -n vite,electron -c \"#93c5fd,#fca5a5\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder",
    "start": "electron ."
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.0",
    "vite": "^7.0.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.sampoernafinity.desktop",
    "productName": "Sampoernafinity",
    "protocols": {
      "name": "Sampoernafinity Deep Link",
      "schemes": [
        "sampoernafinity"
      ]
    },
    "files": [
      "electron/**/*",
      "dist/**/*"
    ],
    "directories": {
      "output": "release"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tiktok-live-connector": "^2.4.4",
    "ws": "^8.18.2"
  }
}
